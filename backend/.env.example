# Convex deployment URL (set automatically by `npx convex dev`)
# CONVEX_URL is typically set by the Convex CLI, not manually

# TURN REST authentication secret. Generate at least 32 random bytes and set it
# directly in Convex; never commit the value or expose it to a client.
# YAVER_TURN_SECRET=

# OAuth credentials are configured in the web app (Vercel env vars), not here.
