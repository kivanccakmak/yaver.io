[Unit]
Description=Yaver Relay Server — P2P tunnel for mobile-to-desktop connectivity
Documentation=https://github.com/kivanccakmak/yaver.io
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/yaver-relay serve --quic-port=4433 --http-port=8443
NotifyAccess=main
WatchdogSec=30s
TimeoutStartSec=30s
TimeoutStopSec=15s
WorkingDirectory=/var/lib/yaver-relay
StateDirectory=yaver-relay
EnvironmentFile=-/etc/yaver-relay/relay.env
Environment=RELAY_PASSWORD_FILE=/var/lib/yaver-relay/.relay-password
ExecStartPre=/usr/local/libexec/yaver-relay-timecheck
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# Logging — all output goes to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=yaver-relay

# Performance
LimitNOFILE=65535
TasksMax=1024
CPUAccounting=true
CPUQuota=150%
MemoryAccounting=true
MemoryHigh=768M
MemoryMax=1G
MemorySwapMax=512M
OOMPolicy=stop
OOMScoreAdjust=-500

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
