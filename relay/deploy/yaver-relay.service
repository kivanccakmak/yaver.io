[Unit]
Description=Yaver Relay Server — authenticated Web/QUIC gateway
Documentation=https://github.com/yaver-io/yaver.io
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=15min
StartLimitBurst=5

[Service]
# Current released relay binaries do not emit sd_notify READY/WATCHDOG frames.
# Keep Type=simple until a preflight proves the exact deployed binary does;
# Type=notify would turn a healthy listener into a perpetual start-timeout loop.
Type=simple
TimeoutStartSec=30s
TimeoutStopSec=30s
ExecStartPre=/usr/local/libexec/yaver-relay-timecheck
ExecStart=/usr/local/bin/yaver-relay serve --quic-port=4433 --http-port=8080 --turn-port=0
WorkingDirectory=/var/lib/yaver-relay
StateDirectory=yaver-relay
StateDirectoryMode=0700
EnvironmentFile=-/etc/default/yaver-relay
EnvironmentFile=-/etc/yaver-relay/relay.env
# Optional. If absent, the relay stays healthy but GET /ice fails closed with a
# named 503. The credential bytes never appear in this unit or the command line.
Environment=TURN_AUTH_SECRET_FILE=/etc/yaver-relay/turn-secret
Restart=on-failure
RestartSec=5s
RestartSteps=6
RestartMaxDelaySec=5min
KillMode=mixed
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSIGKILL=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=yaver-relay

LimitNOFILE=65535
TasksMax=512
CPUAccounting=true
CPUQuota=150%
MemoryAccounting=true
MemoryHigh=768M
MemoryMax=1G
MemorySwapMax=256M
ManagedOOMMemoryPressure=kill
ManagedOOMMemoryPressureLimit=85%
OOMPolicy=stop
OOMScoreAdjust=-250

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RemoveIPC=true
ReadWritePaths=/var/lib/yaver-relay
UMask=0077

[Install]
WantedBy=multi-user.target
