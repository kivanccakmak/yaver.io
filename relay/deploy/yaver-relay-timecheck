#!/usr/bin/env bash
set -euo pipefail

if ! command -v timedatectl >/dev/null 2>&1; then
  exit 0
fi

timedatectl set-ntp true >/dev/null 2>&1 || true
# Starting the service must never wait forever for an external clock source.
# Ten seconds is enough for an already-configured systemd-timesyncd to report
# its state; the relay then starts with a warning and the watchdog remains able
# to recover it independently.
for _ in $(seq 1 10); do
  if [[ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)" == "yes" ]]; then
    exit 0
  fi
  sleep 1
done

echo "warning: NTP is not synchronized; starting relay with unsynchronized clock" >&2
exit 0
