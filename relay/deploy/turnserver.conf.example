# Production values such as the public address and shared authentication secret
# are generated on the relay host and must never be committed.
listening-port=3478
tls-listening-port=5349
listening-ip=PUBLIC_IPV4
relay-ip=PUBLIC_IPV4
# Add external-ip=PUBLIC_IPV4/PRIVATE_IPV4 only when the relay is behind NAT.
min-port=49160
max-port=49260
fingerprint
use-auth-secret
static-auth-secret=GENERATED_ON_HOST
realm=public.yaver.io
server-name=public.yaver.io
stale-nonce=600
user-quota=4
total-quota=200
max-bps=10000000
bps-capacity=200000000
no-cli
no-multicast-peers
no-tlsv1
no-tlsv1_1
cert=/etc/turnserver/tls/fullchain.pem
pkey=/etc/turnserver/tls/privkey.pem
log-file=stdout
simple-log
